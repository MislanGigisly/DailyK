{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Aliases */
    "paths": {
      "@/*": ["./src/*"],
      "app/*": ["./src/app/*"],
      "assets/*":["./src/assets/*"],
      "features/*": ["./src/features/*"],
      "componets/*":["./src/features/componets/*"],
      "pages/*": ["./src/pages/*"],
      "layouts/*":["./src/layouts/*"],
      "ui/*":["./src/shared/ui/*"],
      "lib/*":["./src/shared/lib/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}